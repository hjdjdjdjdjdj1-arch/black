-- ============================================
-- FUNÇÃO PARA ENVIAR REMOTE
-- ============================================

local function FireRemote(path, params)
    local success, result = pcall(function()
        local remote = game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Packages"):WaitForChild("Events"):WaitForChild("RemoteEvent")
        
        local args = {
            [1] = {
                [1] = {
                    ["Params"] = params,
                    ["Path"] = path
                }
            }
        }
        
        remote:FireServer(unpack(args))
        return true
    end)
    
    if success then
        print("✅ " .. path)
    else
        print("❌ " .. path .. " - " .. tostring(result))
    end
    
    return success
end

