local function ExecuteAll()
    print("\n==========================================")
    print("   🚀 EXECUTANDO FUNÇÕES")
    print("==========================================\n")
    
    -- 1. Settings
    if CONFIG.Settings.Enabled then
        print("📌 Configurando Settings...")
        
        if CONFIG.Settings.UltraPerformance then
            print("   ⚡ Ultra Performance")
            SetUltraPerformance()
            task.wait(0.3)
        end
        
        if CONFIG.Settings.AutoClaimTimeRewards then
            print("   ⏱️ Auto Claim Time Rewards")
            SetAutoClaimTimeRewards()
            task.wait(0.3)
        end
        
        if CONFIG.Settings.AutoClaimAchievements then
            print("   🏆 Auto Claim Achievements")
            SetAutoClaimAchievements()
            task.wait(0.3)
        end
    end
    
    -- 2. Auto Gamemodes
    if CONFIG.AutoGamemodes.Enabled then
        print("📌 Configurando Auto Gamemodes...")
        for i, mode in ipairs(CONFIG.AutoGamemodes.Modes) do
            print(string.format("   [%d/%d] %s", i, #CONFIG.AutoGamemodes.Modes, mode))
            SetAutoGamemode(mode)
            task.wait(0.5)
        end
    end
    
    -- 3. Select
    if CONFIG.Select.Enabled then
        print("📌 Select Hawk...")
        SelectHawk()
        task.wait(0.5)
    end
    
    -- 4. Daily Diamonds
    if CONFIG.DailyDiamonds then
        print("📌 Daily Diamonds...")
        StartDailyDiamonds()
        task.wait(0.5)
        ClaimDailyDiamonds()
        task.wait(0.5)
        ClaimDailyReward()
        task.wait(0.5)
    end
    
    -- 5. Codes
    if #CONFIG.Codes > 0 then
        print("📌 Códigos...")
        for i, code in ipairs(CONFIG.Codes) do
            print(string.format("   [%d/%d] %s", i, #CONFIG.Codes, code))
            RedeemCode(code)
            task.wait(0.5)
        end
    end
    
    -- 6. Dungeon
    if CONFIG.Dungeon.Enabled then
        print("📌 Entrando na Dungeon: " .. CONFIG.Dungeon.Mode)
        JoinDungeon(CONFIG.Dungeon.Mode)
        task.wait(0.5)
    end
    
    print("\n✅ CICLO CONCLUÍDO!")
end

